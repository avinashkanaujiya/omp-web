{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-desktop",
  "version": "0.2.10",
  "identifier": "com.ddallabenetta.omp-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:30141",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "omp-desktop",
        "width": 1280,
        "height": 800,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../node_modules": "node_modules",
      "../.next": ".next",
      "../bin": "bin",
      "../public": "public",
      "../next.config.ts": "next.config.ts",
      "../package.json": "package.json",
      "resources/bun-darwin-aarch64": "bun-darwin-aarch64",
      "resources/bun-darwin-x64": "bun-darwin-x64",
      "resources/bun-windows-x64.exe": "bun-windows-x64.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQUUzNDI5MDdGNjUxRjIKUldUeVVmWUhLVFN1VHNRdUdORm1wZjZlZUIxaWlFSDd6T3l6b20yRnJ4U1BVempBbWdxVTZXdFgK",
      "endpoints": [
        "https://github.com/ddallabenetta/omp-web/releases/latest/download/latest.json"
      ]
    }
  }
}
